# Supabase bağlantısı — gerçek değerleri .env.local içine koy (bu dosya örnektir).
# Proje base URL'i (sonunda /rest/v1/ OLMADAN).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Publishable / anon anahtar (public; client tarafında kullanılır).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
